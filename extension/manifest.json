{
  "manifest_version": 3,
  "name": "VoxArcana",
  "version": "0.1.0",
  "description": "Narra texto selecionado usando o VoxArcana TTS local.",
  "permissions": [
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VoxArcana"
  }
}
