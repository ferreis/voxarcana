{
  "manifest_version": 3,
  "name": "VoxArcana",
  "version": "0.3.0",
  "description": "Leia textos digitados ou selecionados com vozes em português e narração local personalizada.",
  "permissions": [
    "contextMenus",
    "offscreen",
    "storage",
    "tts"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VoxArcana — ler texto",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
